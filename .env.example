# UGC Monitor — 환경 변수 템플릿
# 이 파일을 복사해서 .env 로 이름 바꾸고 각 값 채우기
# cp .env.example .env

# ── 필수 ──────────────────────────────────────

# NAMC (Gemini via Vertex AI) — 사내망 VPN 필수
NAVER_API_KEY=
NAVER_API_URL=https://namc-aigw.io.naver.com

# Apify (인스타 프로필/스토리 스크래핑) — 팀 공용 토큰. 전지원에게 요청
APIFY_API_TOKEN=

# Google Sheets (스캔 결과 sync) — 시트 ID 는 마스터 시트 URL 에서 추출
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json

# 노션 (자동 스캔 시 프롬프트 + 레퍼런스 이미지 fetch)
NOTION_TOKEN=

# ── 선택 ──────────────────────────────────────

# Slack 웹훅 (스캔 완료 알림)
SLACK_WEBHOOK_URL=

# Gemini Direct (미사용 — NAMC 로 통합됨)
GEMINI_API_KEY=
